# hermes-vps environment — copy to /opt/hermes/.env
# Môi trường hermes-vps — sao chép vào /opt/hermes/.env
# After changes: systemctl restart hermes-gateway hermes-dashboard hermes-mgmt caddy
# Sau khi thay đổi: systemctl restart hermes-gateway hermes-dashboard hermes-mgmt caddy

# --- Core / Lõi ---
# Hermes home directory (HERMES_HOME) / Thư mục HOME của Hermes (HERMES_HOME)
HERMES_HOME=/opt/hermes/.hermes
# Installer version / Phiên bản bộ cài
HERMES_VPS_VERSION=0.1.0
# VPS public IP (fallback) / IP công khai của VPS (dự phòng)
HERMES_DROPLET_IP=127.0.0.1
# Public domain served by Caddy / Tên miền công cộng do Caddy phục vụ
DOMAIN=localhost
# Caddy TLS mode — "tls internal" = self-signed fallback / Chế độ TLS của Caddy — "tls internal" = chứng chỉ tự ký dự phòng
CADDY_TLS=tls internal

# --- Ports / Cổng ---
# Hermes dashboard port / Cổng dashboard của Hermes
HERMES_DASHBOARD_PORT=9119
# Management API port / Cổng Management API
HERMES_MGMT_PORT=9997

# --- Auth (regenerate with: openssl rand -hex 32) ---
# Xác thực (tạo lại bằng: openssl rand -hex 32)
# Token for hermes gateway / Token cho hermes gateway
HERMES_GATEWAY_TOKEN=
# API key for the Management API (required) / Khóa API cho Management API (bắt buộc)
HERMES_MGMT_API_KEY=
# Secret for HMAC-signed session cookies / Bí mật ký cookie phiên HMAC
HERMES_MGMT_SESSION_SECRET=

# --- Login (for /login web page — optional) ---
# Đăng nhập (cho trang /login — tùy chọn)
# Set via: curl -X POST -H "Authorization: Bearer $KEY" \
#   -H "Content-Type: application/json" \
#   -d '{"username":"admin","password":"..."}' \
#   http://localhost:9997/api/auth/create-user
# Username for the web login page / Tên đăng nhập cho trang web
# HERMES_LOGIN_USER=
# bcrypt password hash for the web login / Băm mật khẩu bcrypt cho trang đăng nhập
# HERMES_LOGIN_HASH=

# --- Provider API keys (fill what you use) ---
# Khóa API của nhà cung cấp (điền khóa bạn sử dụng)
# Anthropic (Claude) API key / Khóa API Anthropic (Claude)
# ANTHROPIC_API_KEY=
# OpenAI API key / Khóa API OpenAI
# OPENAI_API_KEY=
# Nous Portal API key / Khóa API Nous Portal
# NOUS_API_KEY=
# OpenRouter API key / Khóa API OpenRouter
# OPENROUTER_API_KEY=
# Hugging Face token / Token Hugging Face
# HUGGINGFACE_TOKEN=
# z.ai (Zhipu) API key / Khóa API z.ai (Zhipu)
# ZAI_API_KEY=
# Kimi (Moonshot) API key / Khóa API Kimi (Moonshot)
# KIMI_API_KEY=
# MiniMax API key / Khóa API MiniMax
# MINIMAX_API_KEY=
# MiMo (Xiaomi) API key / Khóa API MiMo (Xiaomi)
# MIMO_API_KEY=
# Google Gemini API key / Khóa API Google Gemini
# GOOGLE_API_KEY=
# xAI (Grok) API key / Khóa API xAI (Grok)
# XAI_API_KEY=
# DeepSeek API key / Khóa API DeepSeek
# DEEPSEEK_API_KEY=
# Groq API key / Khóa API Groq
# GROQ_API_KEY=
# Mistral API key / Khóa API Mistral
# MISTRAL_API_KEY=
# Together AI API key / Khóa API Together AI
# TOGETHER_API_KEY=
# Hugging Face access token (HF_TOKEN — used by some templates) / Token truy cập Hugging Face (HF_TOKEN — dùng trong một số template)
# HF_TOKEN=
# Moonshot API key / Khóa API Moonshot
# MOONSHOT_API_KEY=

# --- Messaging platform tokens ---
# Token của các nền tảng nhắn tin
# Telegram bot token / Token bot Telegram
# TELEGRAM_BOT_TOKEN=
# Telegram home channel ID / ID kênh Telegram mặc định
# TELEGRAM_HOME_CHANNEL=
# Discord bot token / Token bot Discord
# DISCORD_BOT_TOKEN=
# Discord home channel ID / ID kênh Discord mặc định
# DISCORD_HOME_CHANNEL=
# Slack bot token / Token bot Slack
# SLACK_BOT_TOKEN=
# Slack app token (Socket Mode) / Token app Slack (Socket Mode)
# SLACK_APP_TOKEN=
# Signal account (phone) / Tài khoản Signal (số điện thoại)
# SIGNAL_ACCOUNT=
# Signal HTTP gateway URL / URL cổng HTTP của Signal
# SIGNAL_HTTP_URL=
# Allowed Signal users / Người dùng Signal được phép
# SIGNAL_ALLOWED_USERS=
# WhatsApp mode / Chế độ WhatsApp
# WHATSAPP_MODE=
# Enable WhatsApp / Bật WhatsApp
# WHATSAPP_ENABLED=

# --- Zalo personal plugin (zalo-personal, installed by default) ---
# Plugin Zalo cá nhân (zalo-personal, cài đặt theo mặc định)
# Unofficial Zalo Web API via zca-js Node sidecar. USE A SECONDARY NUMBER —
# bulk friend/message actions risk account bans. First run needs QR login:
#   curl -X POST http://127.0.0.1:3838/login/qr  &&  open http://127.0.0.1:3838/qr.png
# Required: owner Zalo UID (message bot once, grep gateway log for from_uid=).
# API Zalo Web không chính thức qua sidecar Node zca-js. DÙNG SỐ PHỤ — thao tác
# kết bạn/gửi tin hàng loạt có nguy cơ bị khóa tài khoản. Lần chạy đầu cần đăng nhập QR:
#   curl -X POST http://127.0.0.1:3838/login/qr  &&  open http://127.0.0.1:3838/qr.png
# Bắt buộc: UID Zalo của chủ (nhắn cho bot một lần, tìm from_uid= trong log gateway).
ZALO_PERSONAL_OWNER_UID=
# Sidecar port / Cổng sidecar
ZALO_PERSONAL_SIDECAR_PORT=3838
# Session storage dir / Thư mục lưu phiên đăng nhập
ZALO_PERSONAL_SESSION_DIR=/opt/data/zalo
# Anyone who messages the bot can chat without per-user approval. Set false to
# require approving each new user (owner is always allowed).
# Bất kỳ ai nhắn tin cho bot đều được trò chuyện không cần duyệt từng người.
# Đặt false để yêu cầu duyệt từng người dùng mới (chủ sở hữu luôn được phép).
ZALO_PERSONAL_ALLOW_ALL_USERS=true
# Allowed Zalo user IDs (when ALLOW_ALL_USERS=false) / ID người dùng Zalo được phép (khi ALLOW_ALL_USERS=false)
# ZALO_PERSONAL_ALLOWED_USERS=
# Proxy for Zalo sidecar / Proxy cho sidecar Zalo
# ZALO_PERSONAL_PROXY=
# Owner nickname / Biệt danh của chủ sở hữu
# ZALO_OWNER_NICKNAME=sếp
# Owner display name / Tên hiển thị của chủ sở hữu
# ZALO_OWNER_NAME=
# Google token path (Zalo Google login) / Đường dẫn token Google (đăng nhập Zalo qua Google)
# GOOGLE_TOKEN_PATH=
# Default home thread / Luồng trò chuyện mặc định
# ZALO_PERSONAL_HOME_THREAD=
